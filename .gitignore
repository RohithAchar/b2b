# dependencies (matches at any depth, including services/*/)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.firecrawl/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Locally cached CLIP weights for services/image-search development
# (populated on first run into the Transformers.js cache). Never committed;
# the Docker image bakes weights at build time instead.
/models

*storybook.log
storybook-static
