# Copy to .env.local and fill in (never commit secrets).
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Image search: URL + shared secret for the external CLIP inference service
# (services/image-search/). Both are server-only; never prefix with NEXT_PUBLIC_.
IMAGE_SEARCH_SERVICE_URL=
IMAGE_SEARCH_SERVICE_TOKEN=
