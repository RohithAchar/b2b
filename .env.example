NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Management API token (account-level, not project publishable key).
# Used only to apply pending SQL migrations to the hosted project; the hosted
# Postgres port is IPv6-only and unreachable from this machine.
# Rotate both this and the DB password - both were exposed in chat.
SUPABASE_ACCESS_TOKEN=

# Server-only key used to write product image embeddings (lib/supabase/admin.ts).
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
IMAGE_SEARCH_SERVICE_URL=
IMAGE_SEARCH_SERVICE_TOKEN=

# WhatsApp notifications (server-only; never prefix with NEXT_PUBLIC_).
# Leave all three empty to use the mock provider: sends are recorded in the
# notification_outbox table and shown as "Mock only" — no real message goes out.
# They point at a self-hosted OpenWA gateway (https://www.open-wa.org); see
# services/openwa/README.md for setup. OPENWA_API_URL is the API base
# including the /api prefix, e.g. http://localhost:2785/api.
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
